{
  "schemas": [
    {
      "name": "main",
      "tables": [
        {
          "name": "things",
          "columns": [
            { "name": "id", "type": "INTEGER", "null": false },
            { "name": "created_at", "type": "DATETIME", "null": false },
            { "name": "active", "type": "BOOLEAN", "null": false },
            { "name": "code", "type": "VARCHAR(10)", "null": false },
            { "name": "rank", "type": "MEDIUMINT", "null": false },
            { "name": "price", "type": "NUMERIC(10,2)", "null": false },
            { "name": "extra", "type": "FOO", "null": true }
          ],
          "primary_key": { "columns": [{ "name": "id" }] }
        },
        {
          "name": "pairs",
          "columns": [
            { "name": "a", "type": "INTEGER", "null": false },
            { "name": "b", "type": "INTEGER", "null": false }
          ],
          "primary_key": { "columns": [{ "name": "a" }, { "name": "b" }] }
        },
        {
          "name": "codes",
          "columns": [
            { "name": "id", "type": "BIGINT", "null": false },
            { "name": "label", "type": "TEXT", "null": false }
          ],
          "primary_key": { "columns": [{ "name": "id" }] }
        }
      ]
    }
  ]
}
