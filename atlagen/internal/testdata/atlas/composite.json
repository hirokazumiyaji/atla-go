{
  "schemas": [
    {
      "name": "public",
      "tables": [
        {
          "name": "orgs",
          "columns": [
            { "name": "id", "type": "bigserial", "null": false },
            { "name": "name", "type": "text", "null": false }
          ],
          "primary_key": { "parts": [{ "column": "id" }] }
        },
        {
          "name": "users",
          "columns": [
            { "name": "id", "type": "bigserial", "null": false },
            { "name": "email", "type": "text", "null": false }
          ],
          "primary_key": { "columns": [{ "name": "id" }] }
        },
        {
          "name": "memberships",
          "columns": [
            { "name": "org_id", "type": "bigint", "null": false },
            { "name": "user_id", "type": "bigint", "null": false },
            { "name": "slug", "type": "text", "null": false },
            { "name": "role", "type": "text", "null": false, "default": "'member'" },
            { "name": "deleted_at", "type": "timestamptz", "null": true }
          ],
          "primary_key": {
            "columns": [{ "name": "org_id" }, { "name": "user_id" }]
          },
          "indexes": [
            {
              "name": "memberships_org_id_slug_key",
              "unique": true,
              "parts": [{ "column": "org_id" }, { "column": "slug" }]
            },
            {
              "name": "memberships_org_id_lower_slug_key",
              "unique": true,
              "parts": [{ "column": "org_id" }, { "expr": "lower(slug)" }]
            },
            {
              "name": "memberships_user_id_active_key",
              "unique": true,
              "parts": [{ "column": "user_id" }],
              "where": "deleted_at IS NULL"
            },
            {
              "name": "memberships_role_idx",
              "unique": false,
              "parts": [{ "column": "role" }]
            }
          ],
          "foreign_keys": [
            {
              "name": "memberships_org_id_fkey",
              "columns": [{ "name": "org_id" }],
              "ref_columns": [{ "name": "id" }],
              "ref_table": { "name": "orgs" }
            },
            {
              "name": "memberships_user_id_fkey",
              "columns": [{ "name": "user_id" }],
              "ref_columns": [{ "name": "id" }],
              "ref_table": { "name": "users" }
            }
          ]
        },
        {
          "name": "membership_notes",
          "columns": [
            { "name": "id", "type": "bigserial", "null": false },
            { "name": "org_id", "type": "bigint", "null": false },
            { "name": "user_id", "type": "bigint", "null": false },
            { "name": "body", "type": "text", "null": false }
          ],
          "primary_key": { "columns": [{ "name": "id" }] },
          "foreign_keys": [
            {
              "name": "membership_notes_membership_fkey",
              "columns": [{ "name": "org_id" }, { "name": "user_id" }],
              "ref_columns": [{ "name": "org_id" }, { "name": "user_id" }],
              "ref_table": { "name": "memberships" }
            }
          ]
        }
      ]
    }
  ]
}
